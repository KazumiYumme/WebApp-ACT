<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>E-Report Card</title>
<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: Arial, Helvetica, sans-serif;
        background-color: #eef1f5;
        margin: 0;
        padding: 40px 20px;
        color: #222;
    }

    .report-card {
        max-width: 700px;
        margin: 0 auto;
        background-color: #ffffff;
        padding: 30px 40px 40px;
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    h1 {
        text-align: center;
        color: #1a3e8c;
        font-size: 26px;
        letter-spacing: 1px;
        margin-bottom: 25px;
    }

    h2 {
        color: #1a3e8c;
        font-size: 16px;
        border-bottom: 2px solid #1a3e8c;
        padding-bottom: 6px;
        margin-top: 30px;
        margin-bottom: 12px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    /* Student Information table */
    table.student-info td {
        padding: 8px 10px;
        border: 1px solid #cfd6e0;
    }

    table.student-info td.label {
        font-weight: bold;
        background-color: #f4f6fa;
        width: 15%;
        white-space: nowrap;
    }

    /* Academic Grades table */
    table.grades {
        margin-top: 5px;
    }

    table.grades th,
    table.grades td {
        border: 1px solid #cfd6e0;
        padding: 8px 10px;
        text-align: center;
    }

    table.grades td:nth-child(2) {
        text-align: left;
    }

    table.grades thead th,
    table.grades tr:first-child th {
        background-color: #1a3e8c;
        color: #ffffff;
        font-weight: bold;
    }

    table.grades td.passed {
        color: #1e8f3e;
        font-weight: bold;
    }

    table.grades tr:last-child th {
        background-color: #1a3e8c;
        color: #ffffff;
    }

    table.grades tr:last-child th.passed,
    table.grades tr:last-child th:last-child {
        color: #ffffff;
    }

    .footer {
        margin-top: 30px;
        text-align: center;
        font-size: 12px;
        color: #555;
    }

    .footer p {
        margin: 4px 0;
    }
</style>
</head>
<body>

<div class="report-card">

    <h1>E-REPORT CARD</h1>

    <h2>Student Information</h2>

    <table class="student-info">

        <tr>
            <td class="label">Student Name</td>
            <td>Kristel Ocampo</td>

            <td class="label">Student ID</td>
            <td>2026-00125</td>
        </tr>

        <tr>
            <td class="label">Course</td>
            <td>Associate in Computer Technology</td>

            <td class="label">Year Level</td>
            <td>2nd Year</td>
        </tr>

        <tr>
            <td class="label">Semester</td>
            <td>1st Semester</td>

            <td class="label">School Year</td>
            <td>2026–2027</td>
        </tr>

    </table>


    <h2>Academic Grades</h2>

    <table class="grades">

        <tr>
            <th>Course Code</th>
            <th>Subject</th>
            <th>Units</th>
            <th>Grade</th>
            <th>Remarks</th>
        </tr>

        <tr>
            <td>IT 201</td>
            <td>Web Development</td>
            <td>3</td>
            <td>92</td>
            <td class="passed">Passed</td>
        </tr>

        <tr>
            <td>IT 202</td>
            <td>Database Management</td>
            <td>3</td>
            <td>89</td>
            <td class="passed">Passed</td>
        </tr>

        <tr>
            <td>IT 203</td>
            <td>Object-Oriented Programming</td>
            <td>3</td>
            <td>91</td>
            <td class="passed">Passed</td>
        </tr>

        <tr>
            <td>IT 204</td>
            <td>Computer Networks</td>
            <td>3</td>
            <td>87</td>
            <td class="passed">Passed</td>
        </tr>

        <tr>
            <td>IT 205</td>
            <td>Systems Analysis and Design</td>
            <td>3</td>
            <td>90</td>
            <td class="passed">Passed</td>
        </tr>

        <tr>
            <td>GE 201</td>
            <td>Ethics</td>
            <td>3</td>
            <td>94</td>
            <td class="passed">Passed</td>
        </tr>

        <tr>
            <th colspan="3">General Average</th>
            <th>90.5</th>
            <th class="passed">PASSED</th>
        </tr>

    </table>

    <div class="footer">
        <p><strong>Prepared by:</strong> College Registrar</p>
        <p>This is an electronic report card for academic purposes.</p>
    </div>

</div>

</body>
</html>
